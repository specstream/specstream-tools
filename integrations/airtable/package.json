{
  "name": "@specstream/airtable-extension",
  "version": "1.0.0",
  "private": true,
  "description": "SpecStream for Airtable: ask for live web data in plain words, see the price, approve, and get the records in your table, each with its source.",
  "license": "MIT",
  "homepage": "https://specstream.ai/docs/integrations",
  "scripts": {
    "start": "block run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "block release",
    "submit": "block submit"
  },
  "dependencies": {
    "@airtable/blocks": "1.19.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^17.0.83",
    "@types/react-dom": "^17.0.26",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
