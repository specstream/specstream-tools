    {
      "parameters": {
        "jsCode": "// One message a morning, one line per new grant.\nconst rows = $input.all().map((item) => item.json);\nconst lines = rows.map((row) => {\n  const title = row['Grant'] || row['Funding opportunity'] || 'Untitled grant';\n  const link = row['Source'];\n  const funder = row['Funding agency'] ? ` · ${row['Funding agency']}` : '';\n  const ceiling = row['Award ceiling (USD)'] ? ` · up to $${Number(row['Award ceiling (USD)']).toLocaleString('en-US')}` : '';\n  const closes = row['Application deadline'] ? ` · closes ${row['Application deadline']}` : '';\n  return `• <${link}|${title}>${funder}${ceiling}${closes}`;\n});\nconst search = $('Your grant search').first().json.request;\nreturn [{ json: { text: `*${rows.length} new grant${rows.length === 1 ? '' : 's'}* for \"${search}\"\\n${lines.join('\\n')}` } }];\n"
      },
      "id": "54412052-07fd-5266-8ac5-95077f9a3b34",
