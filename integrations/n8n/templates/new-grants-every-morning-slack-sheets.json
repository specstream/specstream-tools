    {
      "parameters": {
        "jsCode": "// One item per result: each column becomes a field, plus the page the row came from.\nconst out = [];\nfor (const page of $input.all()) {\n  const data = page.json.data || {};\n  const listId = data.find_id;\n  for (const record of data.rows || []) {\n    const row = {};\n    let source;\n    for (const cell of record.cells || []) {\n      // \"matches\" and \"open\" are workspace buttons, not facts.\n      if (['matches', 'open'].includes(cell.column_id)) continue;\n      const label = String(cell.label || cell.column_id || '').trim();\n      if (!label) continue;\n      row[label] = cell.absence ? '' : (cell.display ?? cell.value ?? '');\n      if (!source && cell.provenance && cell.provenance.source_url) source = cell.provenance;\n    }\n    // Extra facts the source published (funder, deadline, official link...), when present.\n    for (const cell of record.details || []) {\n      const label = String(cell.label || '').trim();\n      const value = cell.display ?? cell.value ?? '';\n      if (!label || label in row || cell.absence || Object.values(row).includes(value)) continue;\n      row[label] = value;\n    }\n    row['Source'] = source ? source.source_url : '';\n    row['Read at'] = source ? source.observed_at : '';\n    // Link to the official listing rather than the feed it was read from.\n    if (row['Official opportunity / application']) {\n      row['Source'] = row['Official opportunity / application'];\n      delete row['Official opportunity / application'];\n    }\n    row['Found on'] = $now.toFormat('yyyy-MM-dd');\n    row['List id'] = listId;\n    out.push({ json: row });\n  }\n}\nreturn out;\n"
      },
      "id": "139663b8-662e-5d3e-9825-3facdef12a53",
      "name": "One row per grant",
