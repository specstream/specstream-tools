      "parameters": {
        "jsCode": "// The first run finds the whole list. Every run after that asks only for grants\n// the log doesn't hold yet, by continuing the most recent list.\nconst search = $('Your grant search').first().json;\nconst logged = $input.all().map((item) => item.json).filter((row) => row['List id']);\nconst parent = logged.length ? logged[logged.length - 1]['List id'] : '';\nreturn [{ json: { ...search, parent_find_id: parent, operation: parent ? 'extend' : 'find' } }];\n"
      },
