        "formTitle": "Build a local business lead list",
        "formDescription": "Name the trade and the city. You get every match in your Google Sheet, with phone, website and the page each row came from.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Business type",
              "placeholder": "HVAC companies",
              "requiredField": true
            },
            {
              "fieldLabel": "City",
              "placeholder": "Columbus, Ohio",
              "requiredField": true
            },
            {
              "fieldLabel": "Anything else every business must meet (optional)",
              "placeholder": "rated 4.5 or better with fewer than 20 Google reviews"
            },
            {
              "fieldLabel": "How many businesses",
              "fieldType": "number",
              "placeholder": "100",
              "requiredField": true
            },
            {
              "fieldLabel": "Maximum price in USD",
              "fieldType": "number",
              "placeholder": "10",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Your list is on its way. Rows land in your Google Sheet when the run ends, usually within a few minutes."
            }
          }
        }
      },
