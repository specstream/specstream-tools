    {
      "parameters": {
        "jsCode": "// One item per result: each column becomes a field, plus the page the row came from.\nconst out = [];\nfor (const page of $input.all()) {\n  const data = page.json.data || {};\n  const listId = data.find_id;\n  for (const record of data.rows || []) {\n    const row = {};\n    let source;\n    for (const cell of record.cells || []) {\n      // \"matches\" and \"open\" are workspace buttons, not facts.\n      if (['matches', 'open'].includes(cell.column_id)) continue;\n      const label = String(cell.label || cell.column_id || '').trim();\n      if (!label) continue;\n      row[label] = cell.absence ? '' : (cell.display ?? cell.value ?? '');\n      if (!source && cell.provenance && cell.provenance.source_url) source = cell.provenance;\n    }\n    row['Source'] = source ? source.source_url : '';\n    row['Read at'] = source ? source.observed_at : '';\n    row['List'] = `https://specstream.ai/workspace/collections/${listId}`;\n    out.push({ json: row });\n  }\n}\nreturn out;\n"
      },
