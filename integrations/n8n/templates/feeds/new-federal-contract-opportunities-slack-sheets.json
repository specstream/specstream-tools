      "id": "626231a8-0191-54b1-bfc4-2384e0bfd378",
      "name": "Get new rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
