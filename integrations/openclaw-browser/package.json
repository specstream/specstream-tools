{
  "name": "@specstream/openclaw-browser-plugin",
  "version": "0.1.0",
  "description": "A real Chromium browser in the cloud for OpenClaw agents: open pages, click, type, read and take screenshots with SpecStream browser sessions.",
  "type": "module",
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "specstream",
    "browser",
    "cloud-browser",
    "browser-automation",
    "headless-browser",
    "computer-use",
    "playwright",
    "agent-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specstream/specstream-tools.git",
    "directory": "integrations/openclaw-browser"
  },
  "homepage": "https://specstream.ai/headless-browser-for-ai-agents",
  "author": {
    "name": "SpecStream",
    "url": "https://specstream.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.10.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.3"
    },
    "build": {
      "openclawVersion": "2026.10.3"
    }
  }
}
