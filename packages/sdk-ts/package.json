{
  "name": "@specstream/sdk",
  "version": "1.3.0",
  "description": "TypeScript client for building lead lists and company lists from the live web. Every match comes with its source, priced before it runs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "specstream",
    "local_business",
    "creator",
    "organization",
    "storefront_product",
    "app_listing",
    "job_posting",
    "scholarly_work",
    "tender",
    "grant"
  ],
  "license": "UNLICENSED",
  "homepage": "https://specstream.ai",
  "publishConfig": {
    "access": "public"
  }
}
